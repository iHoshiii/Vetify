# ---- Server ----
PORT=8000
NODE_ENV=development

# MongoDB. Local: `docker compose up -d mongo`. Or an Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/vetify

# Auth secrets — generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string

# Origin allowed by CORS. Only used by non-proxied clients; in dev the Vite
# proxy keeps everything same-origin.
CLIENT_ORIGIN=http://localhost:5173

# ---- AI ----
GEMINI_API_KEY=your_gemini_api_key_here

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=vetify

# ---- Client ----
# Vite only exposes VITE_-prefixed vars to the browser.
VITE_API_URL=/api/v1

# ---- Deferred: social login (Stage 6 leaves these unused) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
