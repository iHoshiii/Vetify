# Copy to .env and set JWT_SECRET_ACCESS before starting the server.
# Chat uses AWS credentials from your local profile or the Lambda execution role.
#
# A var left blank here counts as unset, so the placeholders below can stay empty
# until you have something to put in them.

# ---- Server ----
PORT=8000
NODE_ENV=development

# MongoDB. Local: `docker compose up -d mongo`. Or an Atlas connection string.
# Atlas note: replace the whole <password> placeholder, angle brackets included.
MONGODB_URI=mongodb://localhost:27017/vetify

# Resolvers for Node's SRV/TXT lookups. Leave commented out unless the server
# logs `querySrv ECONNREFUSED` while nslookup and the browser resolve names
# fine — that combination means Node could not read this machine's nameservers
# and fell back to 127.0.0.1, where nothing answers, which strands every
# mongodb+srv:// connection before it opens a socket. Comma-separated; find the
# real ones with `ipconfig /all` (Windows) or `resolvectl status` (Linux), or
# name a public resolver.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Auth secrets — generate with: openssl rand -base64 32
# The name is JWT_SECRET_ACCESS (not JWT_ACCESS_SECRET); env.ts throws at boot
# on the wrong spelling.
JWT_SECRET_ACCESS=replace_me_with_a_long_random_string_at_least_32_chars

# Token lifetimes and cookie name. All optional — these are the defaults env.ts
# applies when the vars are absent.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=refresh_token

# Origin allowed by CORS, and the base of every link the server emails: an
# invitation points at ${CLIENT_ORIGIN}/professionals/apply/<token>, so a wrong
# value here mails out dead links. CORS itself only consults it for non-proxied
# clients; in dev the Vite proxy keeps everything same-origin. Must match the
# Vite port (5173).
CLIENT_ORIGIN=http://localhost:5173

# ---- OAuth / social login ----
# Public base URL of this API, used to build the provider redirect URIs. Must
# match what is registered in each provider console, exactly — no trailing
# slash, and the scheme matters.
SERVER_URL=http://localhost:8000

# Optional Books worker approval checks. Generate: npm run auth:books:secrets
# Copy the generated main fields here; give only MAIN_AUTH_SERVICE_TOKEN to Books.
BOOKS_CAPABILITY_TOKEN_SHA256=
BOOKS_CAPABILITY_TOKEN_EXPIRES_AT=

# Where the browser lands after the OAuth callback finishes. Success goes to a
# client route that exchanges the refresh cookie for an access token.
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
OAUTH_FAILURE_REDIRECT=http://localhost:5173/login?error=oauth

# Signs the short-lived `state` cookie that ties an authorize request to its
# callback (CSRF defence). Generate like the JWT secret above.
OAUTH_STATE_SECRET=replace_me_with_another_long_random_string

# Google — console.cloud.google.com > APIs & Services > Credentials >
# OAuth 2.0 Client ID, type "Web application".
# Authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — developers.facebook.com > My Apps > Facebook Login > Settings.
# Valid OAuth Redirect URI: http://localhost:8000/api/v1/auth/facebook/callback
# Works for app admins/developers/testers immediately; real users need
# Business Verification before `email` gets Advanced Access.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# TikTok — developers.tiktok.com > Manage apps > Login Kit.
# Redirect URI: http://localhost:8000/api/v1/auth/tiktok/callback
# TikTok never returns an email address, only open_id, display name, avatar.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Transactional mail ----
# Professional application mail: invitation links, interview bookings, and decisions.
#
# `log` prints each message to the terminal and sends nothing, which is what you
# want locally — the application link is in the log, ready to paste into a
# browser. `http` posts to a provider speaking Resend's JSON body. There is no
# SMTP transport and no SDK, on purpose.
MAIL_TRANSPORT=log

# From header. A provider rejects any domain it has not verified, so keep the
# .local address for `log` only. Resend's sandbox sender is
# `Vetify <onboarding@resend.dev>`, and it only delivers to the address that owns
# the Resend account — enough to send yourself an invite, useless for mailing a
# real applicant. That needs a domain verified with the provider.
MAIL_FROM=Vetify <no-reply@vetify.local>

# Read only when MAIL_TRANSPORT=http. The URL defaults to Resend; any API taking
# { from, to[], subject, text, html } behind a bearer token works unchanged, so
# switching provider is this one line. Resend keys start with re_ and come from
# resend.com/api-keys. Left blank on `http`, a send fails and is reported to the
# admin who triggered it rather than stopping the server at boot.
MAIL_API_URL=https://api.resend.com/emails
MAIL_API_KEY=

# Authentication mail uses a separate API key and never uses MAIL_API_KEY.
# Use http to deliver confirmation codes, or log to print them locally.
AUTH_MAIL_TRANSPORT=http
AUTH_MAIL_API_KEY=
# Optional overrides. Blank uses MAIL_API_URL and the existing verified MAIL_FROM.
AUTH_MAIL_API_URL=
AUTH_MAIL_FROM=

# ---- AI ----
BEDROCK_REGION=ap-southeast-2
# For local chat calls, run with AWS_PROFILE=vetify-deploy after aws login.


# ---- Client ----
# Optional shared OIDC provider. Configure all required provider fields together.
# Generate independent credentials with npm run auth:oidc:secrets.
OIDC_ISSUER=
OIDC_ANATOMY_CLIENT_SECRET=
OIDC_BOOKS_CLIENT_SECRET=
OIDC_BLOG_CLIENT_SECRET=
OIDC_COOKIE_KEYS=
OIDC_JWKS=

# Vite only exposes VITE_-prefixed vars to the browser.
VITE_API_URL=/api/v1
VITE_BOOKS_ORIGIN=
VITE_BLOGS_ORIGIN=
VITE_ANATOMY_ORIGIN=

# Optional CARTO Basemaps key for the public map and professional map pin picker.
# Without it, the app uses its OpenStreetMap fallback.
# Request a dedicated key and check current quotas: https://carto.com/basemaps/apikey
# This key is visible in the browser and map requests. Restrict its allowed website
# in CARTO and monitor usage. Keep its actual value out of Git.
# Local development: set it in your ignored .env. Production CI: configure the
# GitHub Actions repository secret VITE_CARTO_KEY. Never use a private account key.
VITE_CARTO_KEY=
