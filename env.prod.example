# Copy this sample to env.prod and replace the example addresses and credentials.
# Do not commit env.prod or put it in the Lambda deployment package.
# Lambda reads function environment configuration, not this file automatically.
# Secret values must be supplied securely by deployment/bootstrap before env.ts loads.
# Blank required secrets deliberately prevent the server from starting.

NODE_ENV=production
PORT=8000

# Use the production Vetify main account database, not the Meal Planner database.
# URL-encode the password. This URI contains placeholders, not working credentials.
MONGODB_URI="mongodb+srv://<production_user>:<url_encoded_password>@<main_vetify_cluster>/vetify?appName=vetify-production"
# Normally leave blank and use the AWS-provided DNS resolver.
DNS_SERVERS=

# Example addresses only. Replace every vetify.example.com address before deploying.
# Keep frontend and API on the same HTTPS site, or proxy API through the frontend.
CLIENT_ORIGIN=https://vetify.example.com
SERVER_URL=https://api.vetify.example.com
OAUTH_SUCCESS_REDIRECT=https://vetify.example.com/auth/callback
OAUTH_FAILURE_REDIRECT=https://vetify.example.com/login?error=oauth

# Generate independent production secrets of at least 32 characters.
# Keep the same secrets across all instances of this production deployment.
JWT_SECRET_ACCESS=
OAUTH_STATE_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=refresh_token

# Register SERVER_URL/api/v1/auth/<provider>/callback with each enabled provider.
# Leave both credentials blank when a provider is not configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Use a sender domain verified in Resend, not onboarding@resend.dev or a Gmail sender.
# These example From addresses must be replaced with your verified sender addresses.
# Authentication and professional mail require separate API keys.
AUTH_MAIL_TRANSPORT=http
AUTH_MAIL_API_URL=https://api.resend.com/emails
AUTH_MAIL_FROM="Vetify <no-reply@vetify.example.com>"
AUTH_MAIL_API_KEY=
MAIL_TRANSPORT=http
MAIL_API_URL=https://api.resend.com/emails
MAIL_FROM="Vetify <professionals@vetify.example.com>"
MAIL_API_KEY=

GEMINI_API_KEY=
GEMINI_MODERATION_MODEL=gemini-3.5-flash
GEMINI_BOOK_MODEL=

# Optional TURN service for video calls. Configure all three together.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# FRONTEND BUILD SETTINGS, not Lambda runtime settings.
# /api/v1 requires a production reverse proxy forwarding /api to the backend.
# With direct separate API hosting, use https://api.vetify.example.com/api/v1 instead.
# The existing Socket.IO client also needs /socket.io routed to a realtime server.
VITE_API_URL=/api/v1
# Public basemap key only. Never put server credentials in any VITE_ variable.
VITE_CARTO_KEY=
