# Copy this sample to env.prod and supply production credentials.
# Do not commit env.prod or include it in the release archive.
# Lambda receives server settings from the deployment template's secret.
# A standalone Node server can use --env-file=/etc/vetify/env.prod.
# The frontend builder reads only public VITE_ settings from this file.
# Blank required secrets deliberately prevent the server from starting.

NODE_ENV=production
PORT=8000

# Use the production Vetify main account database, not the Meal Planner database.
# URL-encode the password. This URI contains placeholders, not working credentials.
MONGODB_URI="mongodb+srv://vetify_prod:E5Ran7J9DwRYN4b1@vetify.zr5zpzu.mongodb.net/vetify?retryWrites=true&w=majority&authSource=admin"
MONGODB_PROD_PASS=E5Ran7J9DwRYN4b1
# Normally leave blank and use the AWS-provided DNS resolver.
DNS_SERVERS=

# CloudFront forwards /api to the HTTP API Gateway origin for serverless.
# The alternate Lightsail setup proxies /api and /socket.io through Caddy.
CLIENT_ORIGIN=https://vetify.page
SERVER_URL=https://vetify.page
OAUTH_SUCCESS_REDIRECT=https://vetify.page/auth/callback
OAUTH_FAILURE_REDIRECT=https://vetify.page/login?error=oauth

# Generate independent production secrets of at least 32 characters.
# Keep the same secrets across all instances of this production deployment.
JWT_SECRET_ACCESS=
OAUTH_STATE_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=refresh_token

# Register SERVER_URL/api/v1/auth/<provider>/callback with each enabled provider.
# Leave both credentials blank when a provider is not configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Use a sender domain verified in Resend, not onboarding@resend.dev or a Gmail sender.
# Verify vetify.page in Resend before using these From addresses.
# Authentication and professional mail require separate API keys.
AUTH_MAIL_TRANSPORT=http
AUTH_MAIL_API_URL=https://api.resend.com/emails
AUTH_MAIL_FROM="Vetify <no-reply@vetify.page>"
AUTH_MAIL_API_KEY=
MAIL_TRANSPORT=http
MAIL_API_URL=https://api.resend.com/emails
MAIL_FROM="Vetify <professionals@vetify.page>"
MAIL_API_KEY=

GEMINI_API_KEY=

# Optional TURN service for video calls. Configure all three together.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# FRONTEND BUILD SETTINGS, used only while building the website.
# /api/v1 requires a production reverse proxy forwarding /api to the backend.
# With direct separate API hosting, use https://api.vetify.page/api/v1 instead.
# That alternate setup also requires matching SERVER_URL and provider callbacks.
# The existing Socket.IO client also needs /socket.io routed to a realtime server.
VITE_API_URL=/api/v1
# Enable each launch link only after its separate application is ready.
VITE_BOOKS_ORIGIN=
VITE_BLOGS_ORIGIN=
VITE_ANATOMY_ORIGIN=
# Public basemap key only. Never put server credentials in any VITE_ variable.
VITE_CARTO_KEY=

# API Gateway WebSocket URL from the serverless stack's RealtimeUrl output.
# Blank retains Socket.IO for local/Lightsail usage.
VITE_REALTIME_URL=
# Lambda injects this URL through the deployment template; no AWS keys go here.
REALTIME_MANAGEMENT_ENDPOINT=
