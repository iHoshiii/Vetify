[Unit]
Description=Vetify backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=vetify
Group=vetify
WorkingDirectory=/opt/vetify/current/server
ExecStart=/usr/bin/node --env-file=/etc/vetify/env.prod /opt/vetify/current/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
